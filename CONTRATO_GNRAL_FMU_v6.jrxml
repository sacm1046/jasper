						<font fontName="Arial" size="10"/>
					</textElement>
					<text><![CDATA[<b>3. </b>Partícipe, en adelante, el “Partícipe”:]]></text>
				</staticText>
				<textField>
					<reportElement x="14" y="498" width="526" height="13" forecolor="#003A6F" uuid="b122cf2c-584f-43d7-9f3a-1029c7cf4ac1">
